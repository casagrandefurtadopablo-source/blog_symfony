{% extends 'base_blog.html.twig' %}

{% block title %}Novo Post{% endblock %}

{% block content %}

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h1 class="h3 text-center mb-4">
                        Novo Post
                    </h1>

                    {{ form_start(form) }}

                        <div class="mb-3">

                            {{ form_label(form.title, 'Título', {
                                'label_attr': {
                                    'class': 'form-label'
                                }
                            }) }}

                            {{ form_widget(form.title, {
                                'attr': {
                                    'class': 'form-control',
                                    'placeholder': 'Digite o título do post'
                                }
                            }) }}

                            {{ form_errors(form.title) }}

                        </div>

                        <div class="mb-3">

                            {{ form_label(form.text, 'Texto', {
                                'label_attr': {
                                    'class': 'form-label'
                                }
                            }) }}

                            {{ form_widget(form.text, {
                                'attr': {
                                    'class': 'form-control',
                                    'rows': 8,
                                    'placeholder': 'Escreva o conteúdo do post...'
                                }
                            }) }}

                            {{ form_errors(form.text) }}

                        </div>

                        <div class="mb-3">

                            {{ form_label(form.category, 'Categoria', {
                                'label_attr': {
                                    'class': 'form-label'
                                }
                            }) }}

                            {{ form_widget(form.category, {
                                'attr': {
                                    'class': 'form-select'
                                }
                            }) }}

                            {{ form_errors(form.category) }}

                        </div>

                        <div class="d-flex justify-content-between mt-4">

                            <a href="{{ path('app_home') }}"
                               class="btn btn-secondary">
                                Voltar
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Salvar Post
                            </button>

                        </div>

                    {{ form_end(form) }}

                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}